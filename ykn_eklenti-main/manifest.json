{
  "manifest_version": 3,
  "name": "YKN ve Pasaport Aktarıcı",
  "version": "1.2.127",
  "description": "Topkapı Üniversitesi - YÖKSİS Veri Aktarım Eklentisi",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://goc-staging.topkapiuni.workers.dev/*",
    "https://goc.topkapiuni.workers.dev/*",
    "https://topkapiunigoc.com/*",
    "https://www.topkapiunigoc.com/*",
    "https://topkapiikamet.vercel.app/*",
    "https://apply.topkapi.edu.tr/*",
    "https://yoksis.yok.gov.tr/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "YÖKSİS Otomasyonu"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apply.topkapi.edu.tr/*",
        "https://yoksis.yok.gov.tr/*"
      ],
      "js": [
        "yoksis-field-targets.js",
        "yoksis-student-identity.js",
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://yoksis.yok.gov.tr/*"
      ],
      "js": [
        "yoksis-document-audit.js",
        "yoksis-document-audit-controller.js",
        "gocnet-transfer-controller.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://goc-staging.topkapiuni.workers.dev/*",
        "https://goc.topkapiuni.workers.dev/*",
        "https://topkapiunigoc.com/*",
        "https://www.topkapiunigoc.com/*",
        "https://topkapiikamet.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "portal-security.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf.worker.min.js"
      ],
      "matches": [
        "https://apply.topkapi.edu.tr/*"
      ]
    }
  ]
}
