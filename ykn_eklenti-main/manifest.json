{
  "manifest_version": 3,
  "name": "YÖKSİS Otomasyonu",
  "version": "1.2.34",
  "description": "Topkapı Üniversitesi - YÖKSİS Veri Aktarım Eklentisi",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://apply.topkapi.edu.tr/*",
    "https://yoksis.yok.gov.tr/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YÖKSİS Otomasyonu"
  },
  "content_scripts": [
    {
      "matches": [
        "https://apply.topkapi.edu.tr/*",
        "https://yoksis.yok.gov.tr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
