{
  "manifest_version": 3,
  "name": "YKN ve Pasaport Aktarıcı",
  "version": "1.2.63",
  "description": "Topkapı Üniversitesi - YÖKSİS Veri Aktarım Eklentisi",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://apply.topkapi.edu.tr/*",
    "*://yoksis.yok.gov.tr/*",
    "*://*.yok.gov.tr/*",
    "*://*.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YÖKSİS Otomasyonu"
  },
  "content_scripts": [
    {
      "matches": [
        "*://apply.topkapi.edu.tr/*",
        "*://yoksis.yok.gov.tr/*",
        "*://*.yok.gov.tr/*"
      ],
      "js": ["pdf.min.js", "document-parser.js", "content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "*://*.vercel.app/*",
        "https://*.topkapi.edu.tr/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.min.js"],
      "matches": ["*://apply.topkapi.edu.tr/*"]
    }
  ]
}
