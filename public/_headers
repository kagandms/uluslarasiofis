/goc_logo.png
  Cache-Control: public, max-age=86400

/topkapi_logo.jpg
  Cache-Control: public, max-age=86400

/header_logo.jpg
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/icon.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/favicon-48x48.png
  Cache-Control: public, max-age=86400

/favicon-96x96.png
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400
