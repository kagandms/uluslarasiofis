{
  "name": "ikamet-main",
  "version": "2.2.1",
  "description": "",
  "main": "app.js",
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/**/*.test.js",
    "test:backend": "node --disable-warning=ExperimentalWarning --test test/backendSchema.test.js test/d1Repositories.test.js test/documentStorage.test.js test/backendApiContract.test.js test/applicationTracking.test.js",
    "package:extension": "node scripts/package-extension.mjs",
    "pretest": "npm run package:extension",
    "predev": "npm run package:extension",
    "dev": "vite",
    "dev:worker": "vite dev",
    "prebuild": "npm run package:extension",
    "build": "vite build",
    "prebuild:staging": "npm run package:extension",
    "build:staging": "node scripts/build-staging.mjs",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply uluslarasiofis-local --local",
    "db:migrate:staging": "wrangler d1 migrations apply uluslarasiofis-staging --remote --env staging",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "deploy:dry-run:staging": "npm run build:staging && wrangler deploy --env staging --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kagandms/ikamet.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/kagandms/ikamet/issues"
  },
  "homepage": "https://github.com/kagandms/ikamet#readme",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "6.3.289",
    "vite": "^8.2.2",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "undici": "7.30.0"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  }
}
