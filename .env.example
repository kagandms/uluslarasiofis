# Interim Session 1 staff sign-in for /yetkili/ only. Remove SITE_PASSWORD in Session 2.
# Public routes /, /basvuru/, and /basvurum/ do not use a shared password.
# Use a random JWT signing secret of at least 32 characters.
SITE_PASSWORD=
JWT_SECRET=

# Server-only tebligat proxy configuration.
APPS_SCRIPT_URL=
APPS_SCRIPT_API_KEY=

# OCR providers. Azure is preferred; Google Vision is the fallback.
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
GOOGLE_VISION_API_KEY=

# Exact HTTPS origin used by the production staff portal and extension package.
PORTAL_PRODUCTION_ORIGIN=
