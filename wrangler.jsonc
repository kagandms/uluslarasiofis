{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uluslarasiofis-local",
  "main": "./src/server/worker.js",
  "compatibility_date": "2026-09-28",
  "vars": {
    "APP_ENV": "local",
    "R2_BUCKET_NAME": "uluslarasiofis-documents-local",
    "PRINT_BUCKET_NAME": "uluslarasiofis-print-local",
    "PRINT_ENABLE_A3": "false",
    "PRINT_ENABLE_COLOR": "false",
    "PRINT_ENABLE_DUPLEX": "false",
    "PRINT_MAX_COPIES_PER_JOB": "50",
    "PRINT_MAX_PAGE_COPIES": "200",
    "PUBLIC_DECLARATION_VERSION": "student-information-accuracy-v1"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "*/15 * * * *",
      "0 1 1 * *",
      "0 0 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uluslarasiofis-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "uluslarasiofis-documents-local",
      "remote": false
    },
    {
      "binding": "PRINT_FILES",
      "bucket_name": "uluslarasiofis-print-local",
      "remote": false
    }
  ],
  "env": {
    "staging": {
      "name": "goc-staging",
      "triggers": {
        "crons": []
      },
      "vars": {
        "APP_ENV": "staging",
        "R2_BUCKET_NAME": "uluslarasiofis-documents-staging",
        "PRINT_BUCKET_NAME": "uluslarasiofis-print-staging",
        "PRINT_ENABLE_A3": "false",
        "PRINT_ENABLE_COLOR": "false",
        "PRINT_ENABLE_DUPLEX": "false",
        "PRINT_MAX_COPIES_PER_JOB": "50",
        "PRINT_MAX_PAGE_COPIES": "200",
        "PUBLIC_DECLARATION_VERSION": "student-information-accuracy-v1",
        "STAFF_SHARED_USERNAME": "international.office.topkapi@topkapi.edu.tr"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "uluslarasiofis-staging",
          "database_id": "2ef78af7-be99-4a8d-bc63-0be2a9704e96",
          "migrations_dir": "migrations",
          "remote": false
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENTS",
          "bucket_name": "uluslarasiofis-documents-staging",
          "remote": false
        },
        {
          "binding": "PRINT_FILES",
          "bucket_name": "uluslarasiofis-print-staging",
          "remote": false
        }
      ]
    },
    "production": {
      "name": "goc",
      "triggers": {
        "crons": [
          "*/5 * * * *",
          "*/15 * * * *",
          "0 1 1 * *",
          "0 0 * * *"
        ]
      },
      "vars": {
        "APP_ENV": "production",
        "PHYSICAL_INTAKE_MODE": "on",
        "PHYSICAL_RECEIPTS_CREATE_ENABLED": "true",
        "PUBLIC_PORTAL_ORIGIN": "https://goc.topkapiuni.workers.dev",
        "PUBLIC_PORTAL_ORIGIN_ALLOWLIST": "https://goc.topkapiuni.workers.dev",
        "D1_ANALYTICS_ACCOUNT_ID": "1500828651b1e7541978c7203e56e822",
        "PRINT_ENABLED": "true",
        "PRINT_UAT_ENABLED": "false",
        "R2_BUCKET_NAME": "uluslarasiofis-documents-production",
        "PRINT_BUCKET_NAME": "uluslarasiofis-print-production",
        "PRINT_ENABLE_A3": "false",
        "PRINT_ENABLE_COLOR": "true",
        "PRINT_ENABLE_DUPLEX": "false",
        "PRINT_MAX_COPIES_PER_JOB": "50",
        "PRINT_MAX_PAGE_COPIES": "200",
        "PUBLIC_DECLARATION_VERSION": "student-information-accuracy-v1",
        "STAFF_SHARED_USERNAME": "international.office.topkapi@topkapi.edu.tr"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "uluslarasiofis-production",
          "database_id": "74b45974-8665-4616-bce0-3380da71c22f",
          "migrations_dir": "migrations",
          "remote": false
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENTS",
          "bucket_name": "uluslarasiofis-documents-production",
          "remote": false
        },
        {
          "binding": "PRINT_FILES",
          "bucket_name": "uluslarasiofis-print-production",
          "remote": false
        }
      ],
      "secrets": {
        "required": [
          "PRINTER_SECRET",
          "PRINT_R2_ACCESS_KEY_ID",
          "PRINT_R2_SECRET_ACCESS_KEY"
        ]
      }
    }
  }
}
